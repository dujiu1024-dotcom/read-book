{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://read-book.local/schemas/chapters.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["chapter_id", "parent_chapter_id", "title", "level", "order_index", "start_locator", "end_locator"],
    "properties": {
      "chapter_id": { "type": "string", "minLength": 1 },
      "parent_chapter_id": { "type": ["string", "null"] },
      "title": { "type": "string", "minLength": 1 },
      "level": { "type": "integer", "minimum": 1, "maximum": 12 },
      "order_index": { "type": "integer", "minimum": 0 },
      "start_locator": { "type": "string", "minLength": 1 },
      "end_locator": { "type": "string", "minLength": 1 },
      "page_start": { "type": ["integer", "null"], "minimum": 1 },
      "page_end": { "type": ["integer", "null"], "minimum": 1 },
      "source_heading": { "type": ["string", "null"] }
    }
  }
}