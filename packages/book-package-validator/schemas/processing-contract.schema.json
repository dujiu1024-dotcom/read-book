{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://read-book.local/schemas/processing-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "revision_states",
    "attempt_states",
    "stages",
    "revision_transitions",
    "attempt_transitions",
    "idempotency",
    "acceptance_gates"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "revision_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "uploaded",
          "validating_package",
          "queued",
          "processing",
          "quality_check",
          "accepted",
          "pending_rights_review",
          "publishable",
          "published",
          "rejected",
          "retryable_failed",
          "failed",
          "needs_rework"
        ]
      }
    },
    "attempt_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "retryable_failed",
          "failed",
          "cancelled"
        ]
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "depends_on",
          "retry_scope"
        ],
        "properties": {
          "stage": {
            "enum": [
              "package_inspection",
              "source_verification",
              "metadata_normalization",
              "parse",
              "normalize",
              "structure",
              "chunk",
              "embedding",
              "index_build",
              "quality_check",
              "rights_review",
              "publish"
            ]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "retry_scope": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "revision_transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "attempt_transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_identity",
        "attempt_identity",
        "retry_behavior"
      ],
      "properties": {
        "package_identity": {
          "type": "string",
          "minLength": 1
        },
        "attempt_identity": {
          "type": "string",
          "minLength": 1
        },
        "retry_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "required",
          "applies_to",
          "criteria"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "applies_to": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "enum": [
                "accept",
                "publish"
              ]
            }
          },
          "criteria": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}