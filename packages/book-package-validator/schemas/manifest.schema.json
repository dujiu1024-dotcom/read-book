{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://read-book.local/schemas/manifest.schema.json",
  "title": "Read Book Package Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "package_id", "created_at", "source", "book", "processing", "artifacts", "counts"],
  "properties": {
    "schema_name": { "const": "read-book-package" },
    "schema_version": { "const": "1.0.0" },
    "package_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "format", "sha256", "size_bytes"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "format": { "enum": ["epub", "pdf", "txt"] },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "book": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "authors", "language", "isbn", "edition", "translator", "publisher"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "language": { "type": "string", "minLength": 2 },
        "isbn": { "type": ["string", "null"] },
        "edition": { "type": ["string", "null"] },
        "translator": { "type": ["string", "null"] },
        "publisher": { "type": ["string", "null"] }
      }
    },
    "processing": {
      "type": "object", "additionalProperties": false,
      "required": ["processor_name", "processor_version", "rules_version", "parser", "parser_version"],
      "properties": {
        "processor_name": { "type": "string", "minLength": 1 },
        "processor_version": { "type": "string", "minLength": 1 },
        "rules_version": { "type": "string", "minLength": 1 },
        "parser": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["book", "chapters", "chunks", "assets", "embeddings", "local_report"],
      "properties": {
        "book": { "type": "string", "minLength": 1 },
        "chapters": { "type": "string", "minLength": 1 },
        "chunks": { "type": "string", "minLength": 1 },
        "assets": { "type": ["string", "null"] },
        "embeddings": { "type": ["string", "null"] },
        "local_report": { "type": ["string", "null"] }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["chapters", "chunks", "assets"],
      "properties": {
        "chapters": { "type": "integer", "minimum": 1 },
        "chunks": { "type": "integer", "minimum": 1 },
        "assets": { "type": "integer", "minimum": 0 }
      }
    }
  }
}