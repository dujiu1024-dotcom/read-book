{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://read-book.local/schemas/local-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "overall_status", "summary", "issues", "created_at"],
  "properties": {
    "report_version": { "type": "string", "const": "1.0.0" },
    "batch_id": { "type": ["string", "null"], "format": "uuid" },
    "revision_id": { "type": ["string", "null"], "format": "uuid" },
    "attempt_id": { "type": ["string", "null"], "format": "uuid" },
    "overall_status": { "enum": ["valid", "needs_rework", "rejected"] },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["error_count", "warning_count"],
      "properties": {
        "error_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 }
      }
    },
    "issues": { "type": "array", "items": { "$ref": "validation-issue.schema.json" } },
    "created_at": { "type": "string", "format": "date-time" }
  }
}