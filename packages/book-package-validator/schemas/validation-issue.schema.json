{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://read-book.local/schemas/validation-issue.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue_code", "severity", "stage", "message", "retryable"],
  "properties": {
    "issue_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "severity": { "enum": ["error", "warning", "info"] },
    "stage": { "type": "string", "minLength": 1 },
    "artifact": { "type": ["string", "null"] },
    "record_id": { "type": ["string", "null"] },
    "chapter_id": { "type": ["string", "null"] },
    "page_number": { "type": ["integer", "null"], "minimum": 1 },
    "message": { "type": "string", "minLength": 1 },
    "evidence": { "type": ["object", "array", "string", "null"] },
    "suggested_action": { "type": ["string", "null"] },
    "retryable": { "type": "boolean" }
  }
}