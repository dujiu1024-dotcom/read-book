{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:read-book:book-package:1.0.0:manifest",
  "title": "Read Book Package Manifest 1.0.0",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "package_id",
    "created_at",
    "source",
    "book",
    "processing",
    "artifacts",
    "counts"
  ],
  "properties": {
    "schema_name": {
      "const": "read-book-package"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "file",
        "format",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^source/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "format": {
          "type": "string",
          "enum": [
            "epub",
            "pdf",
            "txt"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "book": {
      "type": "object",
      "required": [
        "title",
        "authors",
        "language"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "isbn": {
          "type": [
            "string",
            "null"
          ]
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "translator": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "required": [
        "processor_name",
        "processor_version",
        "rules_version",
        "parser",
        "parser_version"
      ],
      "properties": {
        "processor_name": {
          "type": "string",
          "minLength": 1
        },
        "processor_version": {
          "type": "string",
          "minLength": 1
        },
        "rules_version": {
          "type": "string",
          "minLength": 1
        },
        "parser": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "book",
        "chapters",
        "chunks",
        "embeddings",
        "local_report"
      ],
      "properties": {
        "book": {
          "type": "string",
          "pattern": "^content/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "chapters": {
          "type": "string",
          "pattern": "^content/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "chunks": {
          "type": "string",
          "pattern": "^content/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "embeddings": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^embeddings/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "local_report": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^validation/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "chapters",
        "chunks",
        "assets"
      ],
      "properties": {
        "chapters": {
          "type": "integer",
          "minimum": 0
        },
        "chunks": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
