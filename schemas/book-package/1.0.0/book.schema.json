{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:read-book:book-package:1.0.0:book",
  "title": "Read Book Metadata 1.0.0",
  "type": "object",
  "required": [
    "title",
    "authors",
    "language"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifiers": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "metadata_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "metadata_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
