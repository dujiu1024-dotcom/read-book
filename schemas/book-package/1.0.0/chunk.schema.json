{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:read-book:book-package:1.0.0:chunk",
  "title": "Read Book Chunk 1.0.0",
  "type": "object",
  "required": [
    "chunk_id",
    "chapter_id",
    "chapter_title",
    "order_index",
    "content",
    "content_sha256",
    "locator_type",
    "start_locator",
    "end_locator",
    "page_number",
    "paragraph_start",
    "paragraph_end",
    "parser_version",
    "chunker_version"
  ],
  "properties": {
    "chunk_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "chapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "chapter_title": {
      "type": "string",
      "minLength": 1
    },
    "order_index": {
      "type": "integer",
      "minimum": 0
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "locator_type": {
      "type": "string",
      "minLength": 1
    },
    "start_locator": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "end_locator": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "page_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "paragraph_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "paragraph_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "chunker_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
